{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reconform contract plan 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scenario": {
      "$ref": "#/$defs/id"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "contains": {
        "type": "object",
        "required": [
          "required"
        ],
        "properties": {
          "required": {
            "const": true
          }
        }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "checkpoint",
          "channel",
          "occurrence",
          "required",
          "expression"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "checkpoint": {
            "$ref": "#/$defs/id"
          },
          "channel": {
            "$ref": "#/$defs/id"
          },
          "occurrence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "required": {
            "type": "boolean"
          },
          "expression": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "exists",
                      "non_empty",
                      "exit_success"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "min",
                  "max"
                ],
                "properties": {
                  "kind": {
                    "const": "between"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              },
              {
                "required": [
                  "kind",
                  "value"
                ],
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "equals"
                  },
                  "value": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "value"
                        ],
                        "properties": {
                          "kind": {
                            "const": "text"
                          },
                          "value": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "value"
                        ],
                        "properties": {
                          "kind": {
                            "const": "bytes"
                          },
                          "value": {
                            "type": "array",
                            "items": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 255
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "value"
                        ],
                        "properties": {
                          "kind": {
                            "const": "scalar"
                          },
                          "value": {
                            "type": "number"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "value"
                        ],
                        "properties": {
                          "kind": {
                            "const": "events"
                          },
                          "value": {
                            "type": "array",
                            "maxItems": 10000,
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "value"
                        ],
                        "properties": {
                          "kind": {
                            "const": "exit"
                          },
                          "value": {
                            "type": "integer",
                            "minimum": -2147483648,
                            "maximum": 2147483647
                          }
                        }
                      },
                      {
                        "required": [
                          "kind",
                          "value"
                        ],
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "json"
                          },
                          "value": {}
                        }
                      }
                    ]
                  }
                }
              },
              {
                "required": [
                  "kind",
                  "pointer"
                ],
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pointer": {
                    "maxLength": 4096,
                    "type": "string"
                  },
                  "kind": {
                    "const": "json_exists"
                  }
                }
              },
              {
                "required": [
                  "kind",
                  "event"
                ],
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "event_contains"
                  },
                  "event": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "kind",
                  "events"
                ],
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "event_order"
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 1024,
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{1,128}$"
    }
  }
}
