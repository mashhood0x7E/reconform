{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Reconform executable capture 1.0",
  "type":"object","additionalProperties":false,
  "required":["schema_version","scenario","subject","steps"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "scenario":{"$ref":"#/$defs/id"},"subject":{"$ref":"#/$defs/id"},
    "steps":{"type":"array","minItems":1,"maxItems":32,"items":{
      "type":"object","additionalProperties":false,
      "required":["checkpoint","executable","args","cwd","env","stdin","timeout_ms","max_output_bytes"],
      "properties":{
        "checkpoint":{"$ref":"#/$defs/id"},"executable":{"type":"string","minLength":1},"cwd":{"type":"string","minLength":1},
        "args":{"type":"array","maxItems":1024,"items":{"type":"string","maxLength":32768}},
        "env":{"type":"object","maxProperties":128,"additionalProperties":{"type":"string","maxLength":32768}},
        "stdin":{"type":"string","maxLength":262144},"timeout_ms":{"type":"integer","minimum":1,"maximum":300000},
        "max_output_bytes":{"type":"integer","minimum":1,"maximum":262144},
        "files":{"type":"array","maxItems":16,"items":{
          "type":"object","additionalProperties":false,"required":["channel","path","max_bytes"],
          "properties":{"channel":{"$ref":"#/$defs/id"},"path":{"type":"string","minLength":1},"max_bytes":{"type":"integer","minimum":1,"maximum":1048576}}
        }}
      }
    }}
  },
  "$defs":{"id":{"type":"string","pattern":"^[a-zA-Z0-9._-]{1,128}$"}}
}
