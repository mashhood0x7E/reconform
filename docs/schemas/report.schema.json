{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reconform verification report 1.0",
  "oneOf": [
    {"$ref":"#/$defs/report"},
    {"type":"object","additionalProperties":false,"required":["schema_version","verdict","code","message"],"properties":{"schema_version":{"const":"1.0"},"verdict":{"const":"error"},"code":{"enum":["CONFIG_INVALID","IO_ERROR"]},"message":{"type":"string"}}}
  ],
  "$defs": {
    "id":{"type":"string","pattern":"^[a-zA-Z0-9._-]{1,128}$"},
    "digest":{"type":"string","pattern":"^blake3:[a-f0-9]{64}$"},
    "input":{"type":"object","additionalProperties":false,"required":["path","digest"],"properties":{"path":{"type":"string","minLength":1},"digest":{"$ref":"#/$defs/digest"}}},
    "subject":{"type":"object","additionalProperties":false,"required":["id","provenance","environment"],"properties":{"id":{"$ref":"#/$defs/id"},"provenance":{"type":"string","minLength":1},"environment":{"type":["string","null"]}}},
    "finding":{
      "type":"object","additionalProperties":false,
      "required":["id","checkpoint","channel","occurrence","required","verdict","code","location"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"checkpoint":{"$ref":"#/$defs/id"},"channel":{"$ref":"#/$defs/id"},
        "occurrence":{"type":"integer","minimum":0,"maximum":4294967295},"required":{"type":"boolean"},
        "verdict":{"enum":["pass","fail","inconclusive","unsupported","error"]},
        "code":{"enum":["ENVIRONMENT_MISMATCH","OBSERVATION_MISSING","OBSERVATION_PARTIAL","KIND_MISMATCH","POLICY_UNSUPPORTED","COMPARE_EQUAL","COMPARE_DIFFERENT","COMPARE_ERROR","CONTRACT_SATISFIED","CONTRACT_VIOLATED","CONTRACT_UNSUPPORTED","CONTRACT_ERROR"]},
        "location":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["kind","index"],"properties":{"kind":{"enum":["byte","event"]},"index":{"type":"integer","minimum":0}}}]}
      }
    },
    "report":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","tool_version","scenario","verdict","method","policy_digest","plan","inputs","subjects","findings","first_divergence","unselected_observations","limitations","reproduce"],
      "properties":{
        "schema_version":{"const":"1.0"},"tool_version":{"type":"string"},"scenario":{"$ref":"#/$defs/id"},
        "verdict":{"enum":["pass","fail","inconclusive","error"]},"method":{"enum":["recorded-parity/1","recorded-contracts/1"]},
        "policy_digest":{"$ref":"#/$defs/digest"},"plan":{"type":"object"},
        "inputs":{"type":"array","minItems":2,"maxItems":3,"items":{"$ref":"#/$defs/input"}},
        "subjects":{"type":"array","minItems":1,"maxItems":2,"items":{"$ref":"#/$defs/subject"}},
        "findings":{"type":"array","minItems":1,"maxItems":1024,"items":{"$ref":"#/$defs/finding"}},
        "first_divergence":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},
        "unselected_observations":{"type":"array","minItems":1,"maxItems":2,"items":{"type":"integer","minimum":0,"maximum":1024}},
        "limitations":{"type":"array","items":{"type":"string"}},"reproduce":{"type":"array","minItems":7,"maxItems":8,"items":{"type":"string"}}
      },
      "allOf":[
        {"if":{"properties":{"method":{"const":"recorded-parity/1"}}},"then":{"properties":{"subjects":{"minItems":2},"inputs":{"minItems":3},"unselected_observations":{"minItems":2}}}},
        {"if":{"properties":{"method":{"const":"recorded-contracts/1"}}},"then":{"properties":{"subjects":{"maxItems":1},"inputs":{"maxItems":2},"unselected_observations":{"maxItems":1}}}}
      ]
    }
  }
}
